# ZM API Configuration
APP_PROFILE=prod
APP_CONFIG_DIR=/etc/zm-api
APP_STATIC_DIR=/usr/share/zm-api/static
APP_LOG_DIR=/var/log/zm-api
RUST_LOG=info

# Browser origins allowed to call this API (CORS). REQUIRED whenever a
# dashboard (zm-web) is served from anything other than localhost — browsers
# block the requests otherwise, and the failure shows up only in the browser
# console, not in this service's log.
#
# Comma-separated. Each entry is an exact origin ("https://zm.example.com") or
# a host with a ":*" port wildcard ("http://localhost:*") matching any port on
# that host. Credentials are enabled, so a bare "*" is not accepted — the CORS
# spec forbids that pairing and browsers reject it.
#
# Unset defaults to localhost only. If zm-web is served from the same origin
# as the API (reverse proxy on one hostname), no CORS request is made and this
# does not apply.
# APP_SERVER__ALLOWED_ORIGINS=https://zm.example.com

# Behind a reverse proxy that publishes the API under a path and strips it
# (/zm/api/v3 -> /api/v3), the links zm-api writes (HLS playlists, media
# links, WHEP, search, Swagger UI) need that path in front.
# APP_SERVER__PUBLIC_PREFIX=/zm

# Serve the zm-web browser UI from this binary instead of running nginx in
# front of both. The UI and the API then share an origin, so no CORS applies
# and APP_SERVER__ALLOWED_ORIGINS above is not needed.
#
# APP_WEB__ROOT must contain zm-web's built index.html.
# APP_WEB__ENABLED=true
# APP_WEB__ROOT=/usr/share/zm-web

# Daemon controller settings
#
# ENABLED=false is "passive" mode: zm-api serves the REST API only and leaves
# ZoneMinder's own daemons (zmdc.pl/zmc/zmfilter/...) alone, so installing the
# package cannot disturb a running ZoneMinder.
#
# Passive is the install-time default, not the end state. Takeover replaces
# zmdc.pl and zmwatch.pl with one native supervisor (restart backoff, DB
# reconciliation, REST daemon control) and is where zm-api is meant to end up.
# Switch when you are ready — and back again just as easily:
#
#   sudo zm-api-takeover            # take over
#   sudo zm-api-takeover --revert   # hand back
#
# Doing it by hand means: disable zoneminder.service, set this to true, restart.
APP_DAEMON__ENABLED=false
APP_DAEMON__SOCKET_NAME=zmdc.sock
# Where ZoneMinder keeps its sockets and binaries. Left unset because one
# packaged value cannot suit every distribution: Debian and Ubuntu use /run/zm,
# the Red Hat family /var/lib/zoneminder/sock. zm-api reads ZM_PATH_SOCKS and
# ZM_PATH_BIN from /etc/zm/zm.conf, the same place zmc reads them from; set
# these only to override that.
# APP_DAEMON__SOCKET_PATH=/run/zm
# APP_DAEMON__BIN_PATH=/usr/bin
# Where zmdc.pl/zmfilter.pl/... live. Left unset because one packaged value
# cannot suit every distribution — Debian/Ubuntu install the Perl scripts to
# /usr/bin, the RPM distros to /usr/share/zoneminder/scripts. zm-api searches
# both (and /usr/local/bin) automatically; set this only to override that.
# APP_DAEMON__SCRIPT_PATH=/usr/share/zoneminder/scripts
APP_DAEMON__ENABLE_SOCKET_IPC=true
APP_DAEMON__ENABLE_WATCHDOG=true

# JWT signing keys. Packaged installs keep these in the service StateDirectory
# (/var/lib/zm-api/keys), not under /usr/share — they are mutable secrets and
# are generated on first install by the package's post-install script.
APP_SECRET__PRIVATE_ACCESS_KEY=/var/lib/zm-api/keys/private_access_rsa_key.pem
APP_SECRET__PUBLIC_ACCESS_KEY=/var/lib/zm-api/keys/public_access_rsa_key.pem
APP_SECRET__PRIVATE_REFRESH_KEY=/var/lib/zm-api/keys/private_refresh_rsa_key.pem
APP_SECRET__PUBLIC_REFRESH_KEY=/var/lib/zm-api/keys/public_refresh_rsa_key.pem

# TLS settings (uncomment and configure as needed)
# APP_SERVER__TLS__ENABLED=true
# APP_SERVER__TLS__CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# APP_SERVER__TLS__KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# ACME/Let's Encrypt settings (uncomment and configure as needed)
# APP_SERVER__ACME__ENABLED=true
# APP_SERVER__ACME__DOMAINS__0=api.example.com
# APP_SERVER__ACME__CONTACT_EMAILS__0=ops@example.com
# APP_SERVER__ACME__CACHE_DIR=/var/lib/zm-api/acme
# APP_SERVER__ACME__PRODUCTION=true
# APP_SERVER__ACME__CHALLENGE=tls-alpn-01
# APP_SERVER__ACME__HTTP_PORT=80
